{%- comment -%}
  Warranty page: what the warranty covers and does not cover.
  Ported from design/pages/Warranty-B.dc.html. Lists are one item per line.
{%- endcomment -%}
{%- liquid
  assign covered = section.settings.covered | newline_to_br | split: '<br />'
  assign not_covered = section.settings.not_covered | newline_to_br | split: '<br />'
-%}
<section class="vx vx-warranty" id="cover" style="background: #fff;">
  <div class="vx-wrap vx-pad-lg" style="max-width: 1360px; margin: 0 auto; padding: 120px 40px;">
    <div style="display: flex; flex-direction: column; gap: 18px; max-width: 720px; margin-bottom: 48px;">
      {%- render 'vx-kicker', text: section.settings.kicker -%}
      <h2 style="margin: 0; font-size: clamp(36px, 4.2vw, 60px); line-height: 1; font-weight: 600; letter-spacing: -0.03em;">{{ section.settings.title }}</h2>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 16px;">
      <div class="vx-wcover-card" style="background: #efebe5; padding: 40px; display: flex; flex-direction: column; gap: 22px;">
        <div style="display: flex; align-items: center; gap: 14px;"><span style="width: 44px; height: 39px; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; background: #1d1c1c; color: #fff; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);"><svg aria-hidden="true" fill="none" height="18" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" width="18"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></span><h3 style="margin: 0; font-size: 26px; font-weight: 600; letter-spacing: -0.015em;">{{ section.settings.covered_title }}</h3></div>
        <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; border-top: 1px solid #cfc7bc;">
          {%- for item in covered -%}
            {%- assign item = item | strip -%}
            {%- if item != blank -%}<li style="padding: 16px 0; border-bottom: 1px solid #cfc7bc; font-size: 16px; line-height: 1.55; color: #3d3a37;">{{ item }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <div class="vx-wcover-card" style="background: #fff; border: 1px solid #e2ddd5; padding: 40px; display: flex; flex-direction: column; gap: 22px;">
        <div style="display: flex; align-items: center; gap: 14px;"><span style="width: 44px; height: 39px; flex: 0 0 auto; display: flex; align-items: center; justify-content: center; background: #efebe5; color: #1d1c1c; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);"><svg aria-hidden="true" fill="none" height="16" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24" width="16"><path d="M6 6l12 12M18 6L6 18"></path></svg></span><h3 style="margin: 0; font-size: 26px; font-weight: 600; letter-spacing: -0.015em;">{{ section.settings.not_covered_title }}</h3></div>
        <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; border-top: 1px solid #e2ddd5;">
          {%- for item in not_covered -%}
            {%- assign item = item | strip -%}
            {%- if item != blank -%}<li style="padding: 16px 0; border-bottom: 1px solid #e2ddd5; font-size: 16px; line-height: 1.55; color: #3d3a37;">{{ item }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px 32px; margin-top: 28px;">
      {%- if section.settings.note != blank -%}<p style="margin: 0; font-size: 15px; line-height: 1.6; color: #5b554f; max-width: 720px;">{{ section.settings.note }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}<a class="vx-wline" href="{{ section.settings.link | default: '#' }}" style="font-weight: 600; font-size: 15px; color: #1d1c1c; border-bottom: 1px solid #1d1c1c; padding-bottom: 3px; text-decoration: none;">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Vertex warranty cover",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "What’s covered" },
    { "type": "text", "id": "title", "label": "Heading", "default": "What the warranty covers" },
    { "type": "text", "id": "covered_title", "label": "Covered heading", "default": "Covered" },
    { "type": "textarea", "id": "covered", "label": "Covered", "info": "One per line.", "default": "Qualifying manufacturing or material defects, under the Vertex warranty terms\n[FADE WARRANTY: what counts as fading, and for how long]\n[WARRANTY PERIOD FOR EACH PRODUCT: decking, cladding, trims]" },
    { "type": "text", "id": "not_covered_title", "label": "Not covered heading", "default": "Not covered" },
    { "type": "textarea", "id": "not_covered", "label": "Not covered", "info": "One per line.", "default": "Incorrect installation\nImproper storage or handling\nMisuse or neglect\nUnauthorised changes to the product\nNot following the care and maintenance instructions" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Exclusions, remedies and limits are set out in the full warranty terms supplied with your order. Nothing in the warranty affects your statutory rights." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the full warranty terms (PDF)" },
    { "type": "url", "id": "link", "label": "Link", "info": "Upload the terms PDF under Content > Files and paste its link here." }
  ],
  "presets": [{ "name": "Vertex warranty cover" }]
}
{% endschema %}
