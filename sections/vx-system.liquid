<section class="vx" style="background: #161616; color: #fff;">
  <div style="display: flex; flex-wrap: wrap;">
    <div class="vx-system__media" style="flex: 1 1 560px; min-width: 0; min-height: 760px; position: relative; overflow: hidden;">
      {%- render 'vx-image', image: section.settings.image, fallback: 'vx-tex-dappled.webp', alt: section.settings.image.alt, style: 'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;', sizes: '(min-width: 990px) 50vw, 100vw' -%}
    </div>
    <div class="vx-system__body" style="flex: 1 1 560px; min-width: 0; padding: 104px 64px; display: flex; flex-direction: column; justify-content: center; gap: 44px;">
      <div style="display: flex; flex-direction: column; gap: 18px; max-width: 520px;">
        {%- render 'vx-kicker', text: section.settings.kicker, color: '#b6855f' -%}
        <h2 style="margin: 0; font-size: clamp(36px, 4.2vw, 60px); line-height: 1; font-weight: 600; letter-spacing: -0.03em;">{{ section.settings.title }}</h2>
        <p style="margin: 0; font-size: 17px; line-height: 1.6; color: #c9c4bd;">{{ section.settings.text }}</p>
      </div>
      <div style="display: flex; flex-direction: column;">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }} style="display: flex; gap: 24px; align-items: center; padding: 22px 0; border-top: 1px solid #333131; color: #fff; text-decoration: none;">
            <div style="width: 112px; height: 84px; flex: 0 0 auto; background: #262525; display: flex; align-items: center; justify-content: center; padding: 10px;">
              {%- if block.settings.image != blank -%}{%- render 'vx-image', image: block.settings.image, alt: '', style: 'width: 100%; height: 100%; object-fit: contain;', width: 300 -%}{%- else -%}<span style="font-size: 11px; color: #8a847d; text-align: center;">[Photo to come]</span>{%- endif -%}
            </div>
            <div style="display: flex; flex-direction: column; gap: 4px;">
              <div style="display: flex; gap: 12px; align-items: baseline;"><span style="font-size: 14px; font-weight: 600; color: #b6855f;">0{{ forloop.index }}</span><span style="font-size: 20px; font-weight: 600;">{{ block.settings.title }}</span></div>
              <div style="font-size: 15px; line-height: 1.5; color: #b3aea7;">{{ block.settings.text }}</div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Vertex the system",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "03 / The system" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Built from the ground up." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Boards, fixings and trims designed to work together. One order, one delivery, one finish." }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "image_picker", "id": "image", "label": "Cut-out image" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" }
    ]}
  ],
  "presets": [{ "name": "Vertex the system" }]
}
{% endschema %}
