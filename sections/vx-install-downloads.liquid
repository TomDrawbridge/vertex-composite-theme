{%- comment -%}
  Downloads list and "Need a hand?" card from the Install-B design.
  A download row can take its file from a product's data sheet (metafield vertex.data_sheet) when one is set.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign anchor_href = '#' | append: s.anchor -%}
<section class="vx vx-wrap vx-pad-lg" id="{{ s.anchor | escape }}" style="max-width: 1360px; margin: 0 auto; padding: 112px 40px; display: flex; flex-wrap: wrap; gap: 56px; scroll-margin-top: 96px;">
  <div style="flex: 1.2 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 28px;">
    <h2 style="margin: 0; font-size: 40px; font-weight: 600; letter-spacing: -0.025em;">{{ s.title }}</h2>
    <div style="display: flex; flex-direction: column; gap: 10px;">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign href = b.link
          assign sheet = b.product.metafields.vertex.data_sheet.value
          if sheet != blank and sheet.url != blank
            assign href = sheet.url
          endif
        -%}
        <a href="{{ href | default: anchor_href }}" {{ block.shopify_attributes }} style="background: #efebe5; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 22px; text-decoration: none; color: #1d1c1c; min-height: 44px;"><span style="display: flex; flex-direction: column; gap: 2px;"><span style="font-weight: 600; font-size: 16px;">{{ b.title }}</span>{%- if b.sub != blank -%}<span style="font-size: 13px; color: #6b655e;">{{ b.sub }}</span>{%- endif -%}</span><svg aria-hidden="true" fill="none" height="22" stroke="#8a5e3b" stroke-width="1.8" viewBox="0 0 24 24" width="22"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg></a>
      {%- endfor -%}
    </div>
    {%- if s.disclaimer != blank -%}<p style="margin: 0; font-size: 14px; line-height: 1.65; color: #6b655e; max-width: 620px;">{{ s.disclaimer }}</p>{%- endif -%}
  </div>
  {%- if s.card_title != blank -%}
    <div style="flex: 1 1 360px; min-width: 0; background: #161616; color: #ffffff; padding: 36px; display: flex; flex-direction: column; gap: 16px; align-self: flex-start;">
      {%- if s.card_kicker != blank -%}<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #b6855f;">{{ s.card_kicker }}</span>{%- endif -%}
      <h3 style="margin: 0; font-size: 28px; line-height: 1.1; font-weight: 600; letter-spacing: -0.02em;">{{ s.card_title }}</h3>
      {%- if s.card_text != blank -%}<p style="margin: 0; font-size: 15px; line-height: 1.6; color: #c9c4bd;">{{ s.card_text }}</p>{%- endif -%}
      {%- if s.email != blank -%}<a href="mailto:{{ s.email | escape }}" style="color: #ffffff; font-weight: 600; font-size: 16px; text-decoration: underline;">{{ s.email }}</a>{%- endif -%}
      {%- if s.button_label != blank -%}<a href="{{ s.button_link }}" style="margin-top: 8px; min-height: 52px; background: #b6855f; color: #161616; text-decoration: none; font-weight: 600; font-size: 15px; display: flex; align-items: center; justify-content: center;">{{ s.button_label }}</a>{%- endif -%}
    </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Vertex downloads and help",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "downloads", "info": "Used by the On this page links, without the #." },
    { "type": "text", "id": "title", "label": "Heading", "default": "Downloads" },
    { "type": "textarea", "id": "disclaimer", "label": "Small print", "default": "This guide is general advice for a typical pedestal deck. Always follow the Vertex data sheet and the pedestal maker’s instructions, and get advice from a qualified professional for roofs, balconies and raised decks." },
    { "type": "header", "content": "Help card" },
    { "type": "text", "id": "card_kicker", "label": "Kicker", "default": "Need a hand?" },
    { "type": "text", "id": "card_title", "label": "Heading", "default": "Talk to us about your deck", "info": "Leave blank to hide the card." },
    { "type": "textarea", "id": "card_text", "label": "Text", "default": "Send us your measurements and photos of the base, and we’ll help you work out what you need." },
    { "type": "text", "id": "email", "label": "Email address", "default": "sales@vertexcomposite.co.uk" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Register your warranty" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "file", "name": "Download", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "sub", "label": "Detail line", "info": "For example PDF · 1.2 MB." },
      { "type": "url", "id": "link", "label": "File or page link", "info": "Upload the PDF under Content > Files and paste its link here." },
      { "type": "product", "id": "product", "label": "Use this product's data sheet", "info": "When the product has a data sheet (metafield vertex.data_sheet), it replaces the link above." }
    ]}
  ],
  "presets": [{ "name": "Vertex downloads and help" }]
}
{% endschema %}
