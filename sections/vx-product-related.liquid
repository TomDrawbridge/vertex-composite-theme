<section class="vx vx-wrap" style="max-width: 1360px; margin: 0 auto; padding: 112px 40px;">
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 40px;">
    <h2 style="margin: 0; font-size: clamp(34px, 3.6vw, 52px); line-height: 1; font-weight: 600; letter-spacing: -0.03em;">{{ section.settings.title }}</h2>
    {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link }}" style="font-weight: 600; font-size: 15px; color: #1d1c1c;">{{ section.settings.link_label }}</a>{%- endif -%}
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
    {%- for p in section.settings.products -%}
      {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
      {%- assign pm = p.metafields.vertex -%}
      <a class="vx-card" href="{{ p.url }}" style="text-decoration: none; color: #1d1c1c; display: flex; flex-direction: column; gap: 16px;">
        <div style="background: #efebe5; aspect-ratio: 1 / 1; display: flex; align-items: center; justify-content: center; padding: 32px; overflow: hidden;">
          {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 700 | image_tag: alt: '', class: 'vx-cut', style: 'width: 100%; height: 100%; object-fit: contain;', sizes: '(min-width: 990px) 25vw, 50vw' }}{%- else -%}<span style="font-size: 14px; color: #8a847d; text-align: center;">[Product photo to come]</span>{%- endif -%}
        </div>
        <div style="display: flex; justify-content: space-between; gap: 12px;">
          <span style="display: flex; flex-direction: column; gap: 4px;"><span style="font-weight: 600; font-size: 17px;">{{ p.title | split: ' (' | first }}</span><span style="font-size: 14px; color: #6b655e;">{{ p.selected_or_first_available_variant.option1 }} · {{ pm.model.value }}{% if pm.length.value != blank %} · {{ pm.length.value }}{% endif %}</span></span>
          <span style="display: flex; flex-direction: column; align-items: flex-end; gap: 2px; flex: 0 0 auto;"><span style="font-weight: 700; font-size: 17px;">{{ p.price | money }}</span><span style="font-size: 12px; color: #8a847d;">{{ pm.unit_label.value | replace: '4 m ', '' }}</span></span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Vertex related products",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Complete the build" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all products" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4 }
  ]
}
{% endschema %}
