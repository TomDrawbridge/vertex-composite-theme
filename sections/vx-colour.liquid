{%- liquid
  assign start = section.settings.start | default: 3
  if start > section.blocks.size
    assign start = 1
  endif
  assign start_i = start | minus: 1
  assign sb = section.blocks[start_i]
-%}
<section class="vx vx-wrap vx-pad-lg" data-vx-colour style="max-width: 1360px; margin: 0 auto; padding: 136px 40px;">
  <div style="display: flex; flex-wrap: wrap; gap: 72px; align-items: stretch;">
    <div class="vx-colour__media" style="flex: 1.25 1 560px; min-width: 0; position: relative; min-height: 720px; overflow: hidden; background: #2a2a2a;">
      {%- for block in section.blocks -%}
        {%- if forloop.index == start -%}{%- assign op = 1 -%}{%- else -%}{%- assign op = 0 -%}{%- endif -%}
        {%- capture st -%}position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: {{ op }};{%- endcapture -%}
        {%- render 'vx-image', image: block.settings.photo, alt: block.settings.photo.alt, class: 'vx-colour__photo', style: st, sizes: '(min-width: 990px) 55vw, 100vw' -%}
      {%- endfor -%}
      <div style="position: absolute; left: 24px; bottom: 24px; width: 46%; min-width: 220px; background: #fff; padding: 18px 20px 14px; display: flex; flex-direction: column; gap: 8px; box-shadow: rgba(0,0,0,0.22) 0 18px 40px;">
        <div style="position: relative;">
          {%- for block in section.blocks -%}
            {%- if forloop.index == start -%}{%- assign d = 'block' -%}{%- else -%}{%- assign d = 'none' -%}{%- endif -%}
            {%- capture st -%}width: 100%; height: auto; display: {{ d }};{%- endcapture -%}
            {%- render 'vx-image', image: block.settings.board, alt: block.settings.name, class: 'vx-colour__board', style: st, width: 900 -%}
          {%- endfor -%}
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 13px; font-weight: 600;"><span>{{ section.settings.card_label }}</span><span style="color: #8a5e3b;" data-vx-colour-name>{{ sb.settings.name }}</span></div>
      </div>
    </div>
    <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 28px;">
      {%- render 'vx-kicker', text: section.settings.kicker -%}
      <h2 style="margin: 0; font-size: clamp(36px, 4.2vw, 60px); line-height: 1; font-weight: 600; letter-spacing: -0.03em;">{{ section.settings.title }}</h2>
      <p style="margin: 0; font-size: 17px; line-height: 1.6; color: #5b554f; max-width: 460px;">{{ section.settings.text }}</p>
      <div aria-label="Choose a colour" role="group" style="display: flex; flex-direction: column; border-top: 1px solid #e2ddd5;">
        {%- for block in section.blocks -%}
          <button class="vx-colour__btn" data-vx-colour-btn data-name="{{ block.settings.name | escape }}" data-link="{{ block.settings.link }}" data-cta="{{ block.settings.cta | escape }}" aria-pressed="{% if forloop.index == start %}true{% else %}false{% endif %}" {{ block.shopify_attributes }} style="display: flex; align-items: center; gap: 20px; width: 100%; padding: 18px 16px 18px 0; background: transparent; border: 0; border-bottom: 1px solid #e2ddd5; cursor: pointer; min-height: 72px; color: #1d1c1c;">
            <span style="width: 44px; height: 38px; flex: 0 0 auto; display: block; background: {{ block.settings.hex }}; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);"></span>
            <span style="display: flex; flex-direction: column; gap: 4px; flex: 1 1 0%; text-align: left;"><span style="font-size: 20px; font-weight: 600; color: #1d1c1c;">{{ block.settings.name }}</span><span style="font-size: 15px; line-height: 1.5; color: #5b554f;">{{ block.settings.short }}</span></span>
            <span aria-hidden="true" class="vx-colour__go" style="display: flex;">{% render 'vx-arrow', size: 20 %}</span>
          </button>
        {%- endfor -%}
      </div>
      <a data-vx-colour-cta href="{{ sb.settings.link }}" style="align-self: flex-start; background: #161616; color: #fff; text-decoration: none; font-weight: 600; font-size: 16px; padding: 18px 28px; min-height: 56px; display: flex; align-items: center;">{{ sb.settings.cta }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Vertex colour picker",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "02 / Colour" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Four colours. Two reversible boards." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "card_label", "label": "Board card label", "default": "Twin Deck · £29.99" },
    { "type": "range", "id": "start", "label": "Colour selected first", "min": 1, "max": 6, "step": 1, "default": 3 }
  ],
  "blocks": [
    { "type": "colour", "name": "Colour", "settings": [
      { "type": "text", "id": "name", "label": "Name" },
      { "type": "color", "id": "hex", "label": "Swatch" },
      { "type": "text", "id": "short", "label": "Description" },
      { "type": "image_picker", "id": "photo", "label": "Garden photo" },
      { "type": "image_picker", "id": "board", "label": "Board cut-out" },
      { "type": "text", "id": "cta", "label": "Button label" },
      { "type": "url", "id": "link", "label": "Button link" }
    ]}
  ],
  "presets": [{ "name": "Vertex colour picker" }]
}
{% endschema %}
