<section class="vx vx-wrap vx-pad-lg" style="max-width: 1360px; margin: 0 auto; padding: 120px 40px;">
  <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 56px; max-width: 720px;">
    {%- render 'vx-kicker', text: section.settings.kicker -%}
    <h2 style="margin: 0; font-size: clamp(36px, 4vw, 56px); line-height: 1; font-weight: 600; letter-spacing: -0.03em;">{{ section.settings.title }}</h2>
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }} style="display: flex; flex-direction: column; gap: 20px;">
        {%- if block.settings.cutout -%}
          <div style="aspect-ratio: 4 / 3; overflow: hidden; background: #efebe5; display: flex; align-items: center; justify-content: center; padding: 32px;">{%- render 'vx-image', image: block.settings.image, alt: '', style: 'width: 100%; height: 100%; object-fit: contain; display: block;', width: 900 -%}</div>
        {%- else -%}
          <div style="aspect-ratio: 4 / 3; overflow: hidden; background: #2a2a2a;">{%- render 'vx-image', image: block.settings.image, alt: '', style: 'width: 100%; height: 100%; object-fit: cover; display: block;', width: 900 -%}</div>
        {%- endif -%}
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <div style="display: flex; gap: 12px; align-items: baseline;"><span style="font-size: 14px; font-weight: 600; color: #8a5e3b;">0{{ forloop.index }}</span><span style="font-size: 22px; font-weight: 600; letter-spacing: -0.01em;">{{ block.settings.title }}</span></div>
          <div style="font-size: 16px; line-height: 1.6; color: #5b554f;">{{ block.settings.text }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Vertex features",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why Twin Deck" },
    { "type": "text", "id": "title", "label": "Heading", "default": "The look of timber, without the upkeep." }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "checkbox", "id": "cutout", "label": "Image is a cut-out (show on sand)", "default": false },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ]}
  ],
  "presets": [{ "name": "Vertex features" }]
}
{% endschema %}
