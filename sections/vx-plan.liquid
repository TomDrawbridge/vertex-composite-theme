<section class="vx" id="guides" style="background: #efebe5;">
  <div class="vx-wrap vx-pad-lg" style="max-width: 1360px; margin: 0 auto; padding: 128px 40px; display: flex; flex-wrap: wrap; gap: 72px; align-items: stretch;">
    <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 28px;">
      {%- render 'vx-kicker', text: section.settings.kicker -%}
      <h2 style="margin: 0; font-size: clamp(36px, 4.2vw, 60px); line-height: 1; font-weight: 600; letter-spacing: -0.03em;">{{ section.settings.title }}</h2>
      <p style="margin: 0; font-size: 17px; line-height: 1.6; color: #5b554f; max-width: 460px;">{{ section.settings.text }}</p>
      <div style="display: flex; flex-direction: column; border-top: 1px solid #cfc7bc; margin-top: 8px;">
        {%- for block in section.blocks -%}
          <a class="vx-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }} style="display: flex; align-items: center; gap: 22px; padding: 20px 0; border-bottom: 1px solid #cfc7bc; text-decoration: none; color: #1d1c1c;">
            <span style="width: 132px; height: 92px; flex: 0 0 auto; overflow: hidden; position: relative; background: #ddd6cc;">{%- render 'vx-image', image: block.settings.image, alt: '', class: 'vx-media', style: 'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;', width: 400 -%}</span>
            <span style="display: flex; flex-direction: column; gap: 6px; flex: 1 1 0%; min-width: 0;"><span style="display: flex; gap: 12px; align-items: baseline;"><span style="font-size: 14px; font-weight: 600; color: #8a5e3b;">0{{ forloop.index }}</span><span style="font-size: 22px; font-weight: 600; letter-spacing: -0.01em;">{{ block.settings.title }}</span></span><span style="font-size: 15px; line-height: 1.5; color: #5b554f;">{{ block.settings.text }}</span></span>
            {%- render 'vx-hex-arrow', dark: true -%}
          </a>
        {%- endfor -%}
      </div>
      {%- if section.settings.help != blank -%}<div style="margin: 0; font-size: 15px; color: #5b554f;">{{ section.settings.help }}</div>{%- endif -%}
    </div>
    <div data-vx-plan data-trim="{{ section.settings.trim_length }}" style="flex: 1.3 1 560px; min-width: 0; background: #161616; color: #fff; padding: 36px; display: flex; flex-direction: column; gap: 28px;">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;">
        <div style="display: flex; flex-direction: column; gap: 4px;"><span style="font-size: 13px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #b6855f;">{{ section.settings.planner_kicker }}</span><span style="font-size: 26px; font-weight: 600; letter-spacing: -0.015em;">{{ section.settings.planner_title }}</span></div>
        <span style="font-size: 13px; color: #a39e97; display: flex; align-items: center; gap: 8px;"><span style="width: 8px; height: 8px; border-radius: 4px; background: #b6855f; display: block;"></span>Live preview</span>
      </div>
      <div style="position: relative; aspect-ratio: 16 / 9; background-color: #1f1e1e; background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 24px 24px; overflow: hidden;">
        <div class="vx-plan__deck" data-vx-deck style="position: absolute; left: 20.7%; top: 18.28%; width: 58.59%; height: 69.44%; border: 5px solid #4f3626; background: repeating-linear-gradient(180deg, #6b4a36 0, #6b4a36 13px, #4f3626 13px, #4f3626 15px); box-shadow: rgba(0,0,0,0.45) 0 24px 48px;">
          <span aria-hidden="true" style="position: absolute; left: 0; right: 0; top: -18px; height: 8px; border-left: 1px solid rgba(255,255,255,0.45); border-right: 1px solid rgba(255,255,255,0.45); background: linear-gradient(rgba(255,255,255,0.45), rgba(255,255,255,0.45)) center / 100% 1px no-repeat;"></span>
          <span data-vx-out="len" style="position: absolute; left: 50%; top: -42px; transform: translateX(-50%); font-size: 13px; font-weight: 600; color: #e6e1da; white-space: nowrap;">4.5 m</span>
          <span aria-hidden="true" style="position: absolute; top: 0; bottom: 0; left: -18px; width: 8px; border-top: 1px solid rgba(255,255,255,0.45); border-bottom: 1px solid rgba(255,255,255,0.45); background: linear-gradient(90deg, rgba(255,255,255,0.45), rgba(255,255,255,0.45)) center / 1px 100% no-repeat;"></span>
          <span data-vx-out="wid" style="position: absolute; top: 50%; left: -26px; transform: translate(-100%, -50%); font-size: 13px; font-weight: 600; color: #e6e1da; white-space: nowrap;">3.0 m</span>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px;">
        <div style="display: flex; flex-direction: column; gap: 8px;"><div style="display: flex; justify-content: space-between; font-size: 14px;"><label for="vx-plan-len-{{ section.id }}" style="color: #c9c4bd;">Length</label><span style="font-weight: 600;" data-vx-out="len">4.5 m</span></div><input class="vx-range" data-vx-in="len" id="vx-plan-len-{{ section.id }}" max="10" min="2" step="0.5" type="range" value="4.5"></div>
        <div style="display: flex; flex-direction: column; gap: 8px;"><div style="display: flex; justify-content: space-between; font-size: 14px;"><label for="vx-plan-wid-{{ section.id }}" style="color: #c9c4bd;">Width</label><span style="font-weight: 600;" data-vx-out="wid">3.0 m</span></div><input class="vx-range" data-vx-in="wid" id="vx-plan-wid-{{ section.id }}" max="8" min="1.5" step="0.5" type="range" value="3"></div>
        <div style="grid-column: 1 / -1; display: flex; flex-direction: column; gap: 8px;"><div style="display: flex; justify-content: space-between; font-size: 14px;"><label for="vx-plan-ht-{{ section.id }}" style="color: #c9c4bd;">Finished deck height, from the base</label><span style="font-weight: 600;" data-vx-out="ht">150 mm</span></div><input class="vx-range" data-vx-in="ht" id="vx-plan-ht-{{ section.id }}" max="400" min="80" step="5" type="range" value="150"></div>
      </div>
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px;">
        <div style="display: flex; align-items: center; gap: 14px;">
          <div aria-label="Board colour" role="group" style="display: flex; gap: 8px;">
            <button class="vx-plan__chip" data-vx-chip data-name="Silver Oak" data-c1="#A9A59D" data-c2="#8b877f" aria-label="Silver Oak" aria-pressed="false" style="width: 40px; height: 35px; padding: 0; border: 0; cursor: pointer; background: #a9a59d; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);"></button>
            <button class="vx-plan__chip" data-vx-chip data-name="Chestnut" data-c1="#6B4A36" data-c2="#4f3626" aria-label="Chestnut" aria-pressed="true" style="width: 40px; height: 35px; padding: 0; border: 0; cursor: pointer; background: #6b4a36; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);"></button>
            <button class="vx-plan__chip" data-vx-chip data-name="Storm" data-c1="#4A4B4C" data-c2="#363738" aria-label="Storm" aria-pressed="false" style="width: 40px; height: 35px; padding: 0; border: 0; cursor: pointer; background: #4a4b4c; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);"></button>
            <button class="vx-plan__chip" data-vx-chip data-name="Eclipse" data-c1="#2e2e2f" data-c2="#18181a" aria-label="Eclipse" aria-pressed="false" style="width: 40px; height: 35px; padding: 0; border: 0; cursor: pointer; background: #2e2e2f; clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);"></button>
          </div>
          <span style="font-size: 14px; font-weight: 600;" data-vx-out="col">Chestnut</span>
        </div>
        <div aria-label="Board direction" role="group" style="display: flex; border: 1px solid #3a3838;">
          <button class="vx-plan__dir" data-vx-dir="length" aria-pressed="true" style="min-height: 40px; padding: 0 14px; border: 0; font-size: 13px; font-weight: 600; cursor: pointer; background: transparent; color: #c9c4bd;">Lengthways</button>
          <button class="vx-plan__dir" data-vx-dir="width" aria-pressed="false" style="min-height: 40px; padding: 0 14px; border: 0; font-size: 13px; font-weight: 600; cursor: pointer; background: transparent; color: #c9c4bd;">Widthways</button>
        </div>
      </div>
      <div class="vx-plan__stats" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid #333131; border-bottom: 1px solid #333131;">
        {%- assign stats = 'area:Deck area,edge:Edge length,trims:L-corner trims,boards:Boards,ped:Pedestal height,peds:Pedestals (guide)' | split: ',' -%}
        {%- for st in stats -%}{%- assign kv = st | split: ':' -%}
          <div style="padding: 18px 16px 18px 0; display: flex; flex-direction: column; gap: 4px;"><span style="font-size: 13px; color: #a39e97;">{{ kv[1] }}</span><span style="font-size: 26px; font-weight: 600; letter-spacing: -0.015em;" data-vx-out="{{ kv[0] }}">{% if kv[0] == 'boards' %}{{ section.settings.boards_text }}{% endif %}</span></div>
        {%- endfor -%}
      </div>
      <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;">
        <span style="font-size: 13px; line-height: 1.5; color: #a39e97; max-width: 340px;">{{ section.settings.note }}</span>
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link }}" style="min-height: 52px; padding: 0 24px; background: #b6855f; color: #161616; border: 0; font-size: 15px; font-weight: 600; cursor: pointer; display: flex; align-items: center; text-decoration: none;">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Vertex plan and planner",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "06 / Plan" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Plan it properly." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Sketch your deck, see it in your colour and get the measurements you need before you order." },
    { "type": "richtext", "id": "help", "label": "Help line", "default": "<p>Need a hand with your plan? <a href=\"mailto:sales@vertexcomposite.co.uk\">Talk to our team</a></p>" },
    { "type": "text", "id": "planner_kicker", "label": "Planner kicker", "default": "Deck planner" },
    { "type": "text", "id": "planner_title", "label": "Planner heading", "default": "See your deck before you buy" },
    { "type": "text", "id": "boards_text", "label": "Boards result", "default": "[TBC]" },
    { "type": "number", "id": "trim_length", "label": "Trim length (m)", "default": 4 },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Pedestal height assumes a 25 mm board on 50 mm joists, and counts use a 6 to 7 per m² guide [CONFIRM]. Board counts need the board width from the data sheet." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get my parts list" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "guide", "name": "Guide", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Vertex plan and planner" }]
}
{% endschema %}
