<footer class="vx" style="background: #161616; color: #c9c4bd;">
  <div class="vx-wrap" style="max-width: 1360px; margin: 0 auto; padding: 88px 40px 36px; display: flex; flex-direction: column; gap: 64px;">
    <div style="display: flex; flex-wrap: wrap; gap: 56px; justify-content: space-between;">
      <div style="flex: 1 1 360px; display: flex; flex-direction: column; gap: 22px; max-width: 420px;">
        {%- render 'vx-image', image: section.settings.logo, fallback: 'vx-logo-light.svg', alt: shop.name, style: 'height: 44px; width: auto; align-self: flex-start;', width: 400 -%}
        <p style="margin: 0; font-size: 16px; line-height: 1.6;">{{ section.settings.newsletter_text }}</p>
        {%- form 'customer', id: 'vx-footer-newsletter', style: 'display: flex; flex-wrap: wrap; gap: 8px;' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="vx-news-email" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%);">Email address</label>
          <input id="vx-news-email" name="contact[email]" type="email" required placeholder="Email address" autocomplete="email" style="flex: 1 1 200px; height: 52px; background: transparent; border: 1px solid #4a4747; color: #fff; padding: 0 16px; font-family: inherit; font-size: 15px; border-radius: 0;">
          <button type="submit" style="height: 52px; padding: 0 22px; background: #fff; color: #161616; border: 0; font-family: inherit; font-weight: 600; font-size: 15px; cursor: pointer;">Sign up</button>
          {%- if form.posted_successfully? -%}<p style="flex-basis: 100%; margin: 4px 0 0; font-size: 14px; color: #fff;">Thanks for signing up.</p>{%- endif -%}
          {%- if form.errors -%}<p style="flex-basis: 100%; margin: 4px 0 0; font-size: 14px; color: #f2b8a2;">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endform -%}
        {%- if section.settings.email != blank -%}<a href="mailto:{{ section.settings.email }}" style="color: #fff; font-weight: 600; font-size: 15px;">{{ section.settings.email }}</a>{%- endif -%}
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 72px;">
        {%- for i in (1..3) -%}
          {%- liquid
            assign key = 'menu_' | append: i
            assign head_key = 'heading_' | append: i
            assign m = linklists[section.settings[key]]
          -%}
          {%- if m.links.size > 0 -%}
            <div style="display: flex; flex-direction: column; gap: 12px; font-size: 15px;">
              <div style="color: #fff; font-weight: 600; margin-bottom: 4px;">{{ section.settings[head_key] }}</div>
              {%- for link in m.links -%}<a href="{{ link.url }}" style="color: #c9c4bd; text-decoration: none;">{{ link.title }}</a>{%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div style="border-top: 1px solid #333131; padding-top: 26px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; font-size: 13px; line-height: 1.6; color: #a39e97;">
      <div>{{ section.settings.legal }}</div>
      <div>{{ section.settings.payments }}</div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Vertex footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (light)" },
    { "type": "text", "id": "newsletter_text", "label": "Sign-up text", "default": "Ideas, new colours and project guides, now and then." },
    { "type": "text", "id": "email", "label": "Email", "default": "sales@vertexcomposite.co.uk" },
    { "type": "link_list", "id": "menu_1", "label": "Menu 1", "default": "footer" },
    { "type": "text", "id": "heading_1", "label": "Menu 1 heading", "default": "Shop" },
    { "type": "link_list", "id": "menu_2", "label": "Menu 2" },
    { "type": "text", "id": "heading_2", "label": "Menu 2 heading", "default": "Help" },
    { "type": "link_list", "id": "menu_3", "label": "Menu 3" },
    { "type": "text", "id": "heading_3", "label": "Menu 3 heading", "default": "Company" },
    { "type": "richtext", "id": "legal", "label": "Legal line", "default": "<p>© 2026 [REGISTERED COMPANY NAME]. Registered in England and Wales, company no. 17264888.<br>Registered office: Unit 2 Mill Pool, Nash Lane, Belbroughton, Stourbridge, DY9 9AF.</p>" },
    { "type": "text", "id": "payments", "label": "Payments line", "default": "Secure payments: Visa · Mastercard · Amex · Apple Pay · Google Pay" }
  ]
}
{% endschema %}
