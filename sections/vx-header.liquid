{%- liquid
  assign overlay = false
  if template.name == 'index' and section.settings.overlay_home
    assign overlay = true
  endif
  assign menu = linklists[section.settings.menu]
  assign show_loader = false
  case section.settings.loader
    when 'home'
      if template.name == 'index'
        assign show_loader = true
      endif
    when 'all'
      assign show_loader = true
  endcase
-%}
{%- if show_loader and request.design_mode == false -%}
  {%- render 'vx-loader', once: section.settings.loader_once -%}
{%- endif -%}
{%- if section.settings.announcement != blank -%}
  <div class="vx vx-announce" style="background: #0f0f0f; color: #d9d6d1; font-size: 13px; letter-spacing: 0.04em; text-align: center; padding: 9px 16px;">
    {%- if section.settings.announcement_link != blank -%}<a href="{{ section.settings.announcement_link }}" style="color: inherit; text-decoration: none;">{{ section.settings.announcement }}</a>{%- else -%}{{ section.settings.announcement }}{%- endif -%}
  </div>
{%- endif -%}
<header class="vx vx-header{% if overlay %} vx-header--overlay{% endif %}" data-vx-header>
  <div style="max-width: 1360px; height: 100%; margin: 0 auto; padding: 0 40px; display: flex; align-items: center; gap: 28px;" class="vx-wrap">
    <a aria-label="{{ shop.name }} home" href="{{ routes.root_url }}" style="display: flex; flex: 0 0 auto;">
      {%- render 'vx-image', image: section.settings.logo, fallback: 'vx-logo-light.svg', alt: shop.name, style: 'height: 38px; width: auto; display: block;', width: 400, loading: 'eager' -%}
    </a>
    <nav aria-label="Main" class="vx-nav" style="display: flex; justify-content: center; gap: 32px; flex: 1 1 auto; font-size: 15px; font-weight: 500;">
      {%- for link in menu.links -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>
    <div style="display: flex; align-items: center; gap: 4px; margin-left: auto;">
      <a aria-label="Search" href="{{ routes.search_url }}" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;"><svg aria-hidden="true" fill="none" height="21" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="21"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg></a>
      {%- if shop.customer_accounts_enabled -%}
        <a aria-label="Account" class="vx-hide-sm" href="{{ routes.account_url }}" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;"><svg aria-hidden="true" fill="none" height="21" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="21"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg></a>
      {%- endif -%}
      <a aria-label="Basket, {{ cart.item_count }} items" href="{{ routes.cart_url }}" style="position: relative; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
        <svg aria-hidden="true" fill="none" height="21" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="21"><path d="M5 8h14l-1.2 12H6.2z"></path><path d="M9 8V6a3 3 0 016 0v2"></path></svg>
        {%- if cart.item_count > 0 -%}<span class="vx-cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
      {%- if section.settings.button_label != blank -%}
        <a class="vx-hide-sm" href="{{ section.settings.button_link }}" style="margin-left: 10px; border: 1px solid rgba(255,255,255,0.7); text-decoration: none; font-weight: 600; font-size: 14px; padding: 12px 20px; min-height: 44px; display: flex; align-items: center;">{{ section.settings.button_label }}</a>
      {%- endif -%}
      <button aria-label="Open menu" aria-expanded="false" class="vx-burger" data-vx-burger style="width: 44px; height: 44px; border: 0; background: transparent; cursor: pointer; display: none; align-items: center; justify-content: center;"><svg aria-hidden="true" fill="none" height="22" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="22"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button>
    </div>
  </div>
</header>
<div class="vx vx-drawer" data-vx-drawer aria-hidden="true">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
    {%- render 'vx-image', image: section.settings.logo, fallback: 'vx-logo-light.svg', alt: shop.name, style: 'height: 34px; width: auto; display: block;', width: 400 -%}
    <button aria-label="Close menu" data-vx-burger style="width: 44px; height: 44px; border: 0; background: transparent; color: #fff; cursor: pointer;"><svg aria-hidden="true" fill="none" height="22" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" width="22"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
  </div>
  {%- for link in menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
  {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link }}" style="color: #b6855f;">{{ section.settings.button_label }}</a>{%- endif -%}
</div>
<script src="{{ 'vx.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Vertex header",
  "class": "vx-header-section",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement", "default": "[DELIVERY OR SAMPLE OFFER MESSAGE]" },
    { "type": "url", "id": "announcement_link", "label": "Announcement link" },
    { "type": "image_picker", "id": "logo", "label": "Logo (light, for dark header)", "info": "Leave blank to use the Vertex logo file in the theme." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Order samples" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "overlay_home", "label": "Transparent over the homepage hero", "default": true },
    { "type": "header", "content": "Intro loader" },
    { "type": "select", "id": "loader", "label": "Show the logo intro", "options": [
      { "value": "home", "label": "On the homepage" },
      { "value": "all", "label": "On every page" },
      { "value": "off", "label": "Off" }
    ], "default": "home" },
    { "type": "checkbox", "id": "loader_once", "label": "Only on the first page view of each visit", "default": false }
  ]
}
{% endschema %}
