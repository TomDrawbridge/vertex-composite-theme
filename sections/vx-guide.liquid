<section class="vx" style="background: #efebe5;">
  <div class="vx-wrap vx-pad-lg" style="max-width: 1360px; margin: 0 auto; padding: 112px 40px; display: flex; flex-wrap: wrap; gap: 72px;">
    <div class="vx-rte" style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 22px; max-width: 560px;">
      {%- render 'vx-kicker', text: section.settings.kicker -%}
      <h2 style="margin: 0; font-size: clamp(32px, 3.6vw, 48px); line-height: 1.02; font-weight: 600; letter-spacing: -0.03em;">{{ section.settings.title }}</h2>
      <div style="display: flex; flex-direction: column; gap: 22px; font-size: 17px; line-height: 1.65; color: #4d4a47;">{{ section.settings.text }}</div>
      <div style="display: flex; flex-wrap: wrap; gap: 16px 28px; margin-top: 6px;">
        {%- if section.settings.link1_label != blank -%}<a href="{{ section.settings.link1 }}" style="font-weight: 600; font-size: 16px; color: #1d1c1c; border-bottom: 1px solid #1d1c1c; padding-bottom: 4px; text-decoration: none;">{{ section.settings.link1_label }}</a>{%- endif -%}
        {%- if section.settings.link2_label != blank -%}<a href="{{ section.settings.link2 }}" style="font-weight: 600; font-size: 16px; color: #1d1c1c; border-bottom: 1px solid #1d1c1c; padding-bottom: 4px; text-decoration: none;">{{ section.settings.link2_label }}</a>{%- endif -%}
      </div>
    </div>
    <div style="flex: 1.2 1 480px; min-width: 0; display: flex; flex-direction: column; border-top: 1px solid #cfc7bc;">
      {%- for block in section.blocks -%}
        <details class="vx-faq" {{ block.shopify_attributes }} {% if forloop.first %}open{% endif %} style="border-bottom: 1px solid #cfc7bc;">
          <summary style="min-height: 68px; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; font-size: 18px; font-weight: 600; color: #1d1c1c; cursor: pointer; list-style: none;"><span>{{ block.settings.q }}</span><span aria-hidden="true" class="vx-faq__icon" style="display: flex; color: #8a5e3b;"><svg fill="none" height="20" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M12 5v14M5 12h14"></path></svg></span></summary>
          <div style="padding: 0 40px 24px 0; font-size: 16px; line-height: 1.65; color: #4d4a47;">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Vertex guide and FAQs",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Buying guide" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Choosing composite decking" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link1_label", "label": "Link 1 label" },
    { "type": "url", "id": "link1", "label": "Link 1" },
    { "type": "text", "id": "link2_label", "label": "Link 2 label" },
    { "type": "url", "id": "link2", "label": "Link 2" }
  ],
  "blocks": [
    { "type": "faq", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question" },
      { "type": "richtext", "id": "a", "label": "Answer" }
    ]}
  ],
  "presets": [{ "name": "Vertex guide and FAQs" }]
}
{% endschema %}
