<section class="vx vx-wrap" id="inspiration" style="max-width: 1360px; margin: 0 auto; padding: 136px 40px 120px;">
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 48px;">
    <div style="display: flex; flex-direction: column; gap: 16px;">
      {%- render 'vx-kicker', text: section.settings.kicker -%}
      <h2 style="margin: 0; font-size: clamp(36px, 4.2vw, 60px); line-height: 1; font-weight: 600; letter-spacing: -0.03em;">{{ section.settings.title }}</h2>
    </div>
    {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link }}" style="font-weight: 600; font-size: 15px; color: #1d1c1c;">{{ section.settings.link_label }}</a>{%- endif -%}
  </div>
  <div class="vx-bento" style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(5, minmax(0, 1fr)); grid-auto-flow: column; gap: 16px; height: 820px;">
    {%- for block in section.blocks -%}
      <figure class="vx-card" {{ block.shopify_attributes }} style="position: relative; margin: 0; overflow: hidden; background: #e2ddd5; min-height: 0; grid-row: span {{ block.settings.span }};">
        {%- render 'vx-image', image: block.settings.image, alt: block.settings.image.alt, class: 'vx-media', style: 'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;', sizes: '(min-width: 760px) 33vw, 50vw' -%}
        <div aria-hidden="true" class="vx-shade" style="position: absolute; inset: 0; background: rgba(10,10,10,0.18);"></div>
        <figcaption style="position: absolute; left: 0; right: 0; bottom: 0; padding: 48px 20px 18px; background: linear-gradient(rgba(10,10,10,0) 0%, rgba(10,10,10,0.62) 100%); color: #fff; font-size: 15px; font-weight: 600;"><span class="vx-lift" style="display: inline-block;">{{ block.settings.label }}</span></figcaption>
      </figure>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Vertex inspiration",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "05 / Inspiration" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Ideas for your space." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View the gallery" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "photo", "name": "Photo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "label", "label": "Caption" },
      { "type": "select", "id": "span", "label": "Height", "options": [{ "value": "2", "label": "Short" }, { "value": "3", "label": "Tall" }], "default": "2" }
    ]}
  ],
  "presets": [{ "name": "Vertex inspiration" }]
}
{% endschema %}
