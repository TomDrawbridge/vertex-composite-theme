{%- comment -%}
  Warranty page: "Warranty questions" accordion. Ported from design/pages/Warranty-B.dc.html,
  using the same details/summary approach as vx-guide (first question open).
{%- endcomment -%}
<section class="vx vx-warranty" style="background: #fff;">
  <div class="vx-wrap vx-pad-lg" style="max-width: 1360px; margin: 0 auto; padding: 120px 40px; display: flex; flex-wrap: wrap; gap: 72px;">
    <div style="flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 22px; max-width: 480px;">
      {%- render 'vx-kicker', text: section.settings.kicker -%}
      <h2 style="margin: 0; font-size: clamp(32px, 3.6vw, 48px); line-height: 1.02; font-weight: 600; letter-spacing: -0.03em;">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}
        <p style="margin: 0; font-size: 17px; line-height: 1.65; color: #4d4a47;">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="vx-wline" href="{{ section.settings.link | default: '#' }}" style="align-self: flex-start; font-weight: 600; font-size: 16px; color: #1d1c1c; border-bottom: 1px solid #1d1c1c; padding-bottom: 4px; text-decoration: none;">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div style="flex: 1.3 1 520px; min-width: 0; display: flex; flex-direction: column; border-top: 1px solid #cfc7bc;">
      {%- for block in section.blocks -%}
        <details class="vx-faq" {{ block.shopify_attributes }} {% if forloop.first and section.settings.first_open %}open{% endif %} style="border-bottom: 1px solid #cfc7bc;">
          <summary style="min-height: 68px; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; font-size: 18px; font-weight: 600; color: #1d1c1c; cursor: pointer; list-style: none;"><span>{{ block.settings.q }}</span><span aria-hidden="true" class="vx-faq__icon" style="display: flex; flex: 0 0 auto; color: #8a5e3b;"><svg fill="none" height="18" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="18"><path d="M12 5v14M5 12h14"></path></svg></span></summary>
          <div class="vx-rte" style="padding: 0 40px 24px 0; font-size: 16px; line-height: 1.65; color: #4d4a47;">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Vertex warranty questions",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Questions" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Warranty questions" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Installing on pedestals? Our step-by-step guide shows what to photograph, and when." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the installation guide" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "first_open", "label": "Open the first question", "default": true }
  ],
  "blocks": [
    { "type": "faq", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question" },
      { "type": "richtext", "id": "a", "label": "Answer" }
    ]}
  ],
  "presets": [{ "name": "Vertex warranty questions" }]
}
{% endschema %}
