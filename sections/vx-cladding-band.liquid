<section class="vx" style="position: relative; min-height: 620px; display: flex; align-items: center; overflow: hidden; background: #3a2a1d;">
  {%- if section.settings.video != blank -%}
    {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1600x', style: 'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;' }}
  {%- else -%}
    <video autoplay muted loop playsinline aria-hidden="true" poster="{{ 'vx-cladding-poster.webp' | asset_url }}" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;"><source src="{{ 'vx-cladding-loop.mp4' | asset_url }}" type="video/mp4"></video>
  {%- endif -%}
  <div aria-hidden="true" style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,10,10,0.25) 0%, rgba(10,10,10,0) 55%);"></div>
  <div class="vx-wrap" style="position: relative; max-width: 1360px; width: 100%; margin: 0 auto; padding: 80px 40px; display: flex; justify-content: flex-end;">
    <div style="background: #fff; padding: 48px; max-width: 520px; display: flex; flex-direction: column; gap: 22px;">
      {%- render 'vx-kicker', text: section.settings.kicker -%}
      <h2 style="margin: 0; font-size: 44px; line-height: 1.02; font-weight: 600; letter-spacing: -0.03em;">{{ section.settings.title }}</h2>
      <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #5b554f;">{{ section.settings.text }}</p>
      {%- if section.blocks.size > 0 -%}
        <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px;">
          {%- for block in section.blocks -%}
            {%- assign p = block.settings.product -%}
            <a href="{{ p.url | default: '#' }}" {{ block.shopify_attributes }} style="background: #efebe5; padding: 12px; display: flex; flex-direction: column; gap: 6px; color: #1d1c1c; text-decoration: none;">
              {%- if block.settings.image != blank -%}{%- render 'vx-image', image: block.settings.image, alt: '', style: 'width: 100%; height: 72px; object-fit: contain;', width: 300 -%}{%- elsif p.featured_image -%}{{ p.featured_image | image_url: width: 300 | image_tag: alt: '', style: 'width: 100%; height: 72px; object-fit: contain;' }}{%- endif -%}
              <span style="font-size: 13px; font-weight: 600;">{{ block.settings.title | default: p.title }}</span><span style="font-size: 13px; color: #5b554f;">{{ p.price | money }}</span>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}<a href="{{ section.settings.link }}" style="align-self: flex-start; font-weight: 600; font-size: 16px; color: #1d1c1c; border-bottom: 1px solid #1d1c1c; padding-bottom: 4px; text-decoration: none;">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Vertex cladding band",
  "settings": [
    { "type": "video", "id": "video", "label": "Video", "info": "Leave blank to use the cladding loop in the theme." },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "04 / Cladding" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Change the character of a building." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop cladding" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "product", "name": "Product", "limit": 3, "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "image_picker", "id": "image", "label": "Cut-out image" },
      { "type": "text", "id": "title", "label": "Title override" }
    ]}
  ],
  "presets": [{ "name": "Vertex cladding band" }]
}
{% endschema %}
