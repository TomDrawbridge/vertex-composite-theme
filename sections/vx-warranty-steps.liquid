{%- comment -%}
  Warranty page: "How it works" three steps. Ported from design/pages/Warranty-B.dc.html.
  Loads the warranty page stylesheet used by all vx-warranty-* sections.
{%- endcomment -%}
{{ 'vx-warranty.css' | asset_url | stylesheet_tag }}
<section class="vx vx-warranty" style="background: #fff;">
  <div class="vx-wrap vx-pad-lg" style="max-width: 1360px; margin: 0 auto; padding: 120px 40px;">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 56px;">
      <div style="display: flex; flex-direction: column; gap: 18px; max-width: 640px;">
        {%- render 'vx-kicker', text: section.settings.kicker -%}
        <h2 style="margin: 0; font-size: clamp(36px, 4.2vw, 60px); line-height: 1; font-weight: 600; letter-spacing: -0.03em;">{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <p style="margin: 0; font-size: 17px; line-height: 1.6; color: #5b554f; max-width: 420px;">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 16px;">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }} style="background: #efebe5; padding: 36px 32px 40px; display: flex; flex-direction: column; gap: 18px;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start;"><span style="font-size: 64px; line-height: 0.9; font-weight: 600; letter-spacing: -0.04em; color: #1d1c1c;">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><svg aria-hidden="true" height="39" viewBox="0 0 52 46" width="44"><polygon fill="none" points="13,1.5 39,1.5 50.5,23 39,44.5 13,44.5 1.5,23" stroke="#b6855f" stroke-width="1.5"></polygon></svg></div>
          <div style="display: flex; flex-direction: column; gap: 10px; padding-top: 28px;"><h3 style="margin: 0; font-size: 24px; font-weight: 600; letter-spacing: -0.015em;">{{ block.settings.title }}</h3><p style="margin: 0; font-size: 16px; line-height: 1.6; color: #4d4a47;">{{ block.settings.text }}</p></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Vertex warranty steps",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How it works" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Three steps to register" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The most important part happens before you finish: photograph the frame while you can still see it." }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Heading" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ]}
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Vertex warranty steps" }]
}
{% endschema %}
