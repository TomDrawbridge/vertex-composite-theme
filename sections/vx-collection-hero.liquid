{%- liquid
  assign title = section.settings.title | default: collection.title
  if collection.handle != 'all' and collection.title != blank
    assign title = collection.title
  endif
  assign intro = section.settings.text
  if collection.handle != 'all' and collection.description != blank
    assign intro = collection.description | strip_html
  endif
  assign img = section.settings.image
  if collection.handle != 'all' and collection.image
    assign img = collection.image
  endif
-%}
<section class="vx" style="position: relative; min-height: 560px; display: flex; flex-direction: column; justify-content: flex-end; color: #fff; background: #161616; overflow: hidden;">
  {%- render 'vx-image', image: img, alt: img.alt, style: 'position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;', sizes: '100vw', loading: 'eager' -%}
  <div aria-hidden="true" style="position: absolute; inset: 0; background: radial-gradient(100% 100% at 100% 100%, rgba(10,10,10,0) 0%, rgba(10,10,10,0.8) 100%);"></div>
  <div class="vx-wrap" style="position: relative; max-width: 1360px; width: 100%; margin: 0 auto; padding: 140px 40px 48px; display: flex; flex-direction: column; gap: 22px;">
    <nav aria-label="Breadcrumb" style="display: flex; gap: 8px; font-size: 14px; color: #d9d6d1;"><a href="{{ routes.root_url }}" style="color: #d9d6d1;">Home</a><span aria-hidden="true">/</span><span style="color: #fff;">{% if collection.handle == 'all' %}Shop{% else %}{{ collection.title }}{% endif %}</span></nav>
    <h1 style="margin: 0; font-size: clamp(44px, 6vw, 88px); line-height: 0.98; font-weight: 600; letter-spacing: -0.035em; text-shadow: rgba(0,0,0,0.3) 0 2px 30px;">{{ title }}</h1>
    <p style="margin: 0; font-size: 19px; line-height: 1.55; color: #f2efea; max-width: 600px; text-shadow: rgba(0,0,0,0.35) 0 1px 16px;">{{ intro }}</p>
    <div aria-label="Shop by category" role="group" style="display: flex; flex-wrap: wrap; gap: 10px; padding-top: 8px;">
      {%- for block in section.blocks -%}
        {%- if block.settings.link == collection.url -%}{%- assign on = true -%}{%- else -%}{%- assign on = false -%}{%- endif -%}
        <a href="{{ block.settings.link }}" {{ block.shopify_attributes }} {% if on %}aria-current="page"{% endif %} style="min-height: 44px; padding: 0 18px; font-size: 15px; font-weight: 600; display: flex; align-items: center; text-decoration: none; {% if on %}border: 1px solid #fff; background: #fff; color: #161616;{% else %}border: 1px solid rgba(255,255,255,0.55); background: rgba(22,22,22,0.3); color: #fff;{% endif %}">{{ block.settings.label }}</a>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- liquid
  if collection.handle == 'all'
    render 'vx-schema-breadcrumb', current: 'Shop'
  else
    render 'vx-schema-breadcrumb', current: collection.title
  endif
-%}
{%- if section.settings.usp_1 != blank -%}
  <div class="vx" style="border-bottom: 1px solid #e2ddd5;">
    <div class="vx-wrap" style="max-width: 1360px; margin: 0 auto; padding: 18px 40px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 32px; font-size: 14px; font-weight: 500; color: #3d3a37;">
      {%- for i in (1..4) -%}
        {%- assign k = 'usp_' | append: i -%}
        {%- if section.settings[k] != blank -%}<span style="display: flex; align-items: center; gap: 10px;"><svg aria-hidden="true" height="14" viewBox="0 0 16 14" width="16"><polygon fill="#b6855f" points="4,1 12,1 15,7 12,13 4,13 1,7"></polygon></svg>{{ section.settings[k] }}</span>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Vertex collection hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (all products)", "info": "Other collections use their own collection image." },
    { "type": "text", "id": "title", "label": "Heading (all products)", "default": "Shop the range" },
    { "type": "textarea", "id": "text", "label": "Text (all products)" },
    { "type": "text", "id": "usp_1", "label": "Strip item 1" },
    { "type": "text", "id": "usp_2", "label": "Strip item 2" },
    { "type": "text", "id": "usp_3", "label": "Strip item 3" },
    { "type": "text", "id": "usp_4", "label": "Strip item 4" }
  ],
  "blocks": [
    { "type": "pill", "name": "Category link", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ]
}
{% endschema %}
