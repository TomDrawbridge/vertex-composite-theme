{%- liquid
  assign parts = product.description | split: '<h3>Specifications</h3>'
  assign rows = ''
  if parts.size > 1
    assign table = parts[1] | split: '</table>' | first
    assign rows = table | split: '<tr>'
  endif
  assign mf = product.metafields.vertex
-%}
<section class="vx" style="background: #efebe5;">
  <div class="vx-wrap vx-pad-lg" style="max-width: 1360px; margin: 0 auto; padding: 112px 40px; display: flex; flex-wrap: wrap; gap: 72px;">
    <div style="flex: 1.3 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 28px;">
      <h2 style="margin: 0; font-size: 40px; font-weight: 600; letter-spacing: -0.025em;">{{ section.settings.specs_title }}</h2>
      <div style="display: flex; flex-direction: column; border-top: 1px solid #cfc7bc;">
        {%- for r in rows -%}
          {%- unless r contains '</th>' -%}{%- continue -%}{%- endunless -%}
          {%- assign k = r | split: '</th>' | first | split: '>' | last -%}
          {%- assign v = r | split: '<td>' | last | split: '</td>' | first -%}
          <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; padding: 16px 0; border-bottom: 1px solid #cfc7bc; font-size: 16px;"><div style="color: #5b554f;">{{ k }}</div><div style="font-weight: 600;">{{ v }}</div></div>
        {%- endfor -%}
        <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; padding: 16px 0; border-bottom: 1px solid #cfc7bc; font-size: 16px;"><div style="color: #5b554f;">Price</div><div style="font-weight: 600;">{{ product.price | money }} {{ mf.unit_label.value }}</div></div>
      </div>
    </div>
    <div style="flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 28px;">
      <h2 style="margin: 0; font-size: 40px; font-weight: 600; letter-spacing: -0.025em;">{{ section.settings.downloads_title }}</h2>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        {%- for block in section.blocks -%}
          {%- liquid
            assign href = block.settings.link
            assign meta = 'PDF · to come'
            if block.settings.source == 'data_sheet' and mf.data_sheet.value != blank
              assign href = mf.data_sheet.value.url
              assign meta = 'PDF'
            elsif block.settings.source == 'safety_data_sheet' and mf.safety_data_sheet.value != blank
              assign href = mf.safety_data_sheet.value.url
              assign meta = 'PDF'
            elsif block.settings.source == 'page'
              assign meta = 'Web page'
            endif
          -%}
          <a href="{{ href | default: '#' }}" {{ block.shopify_attributes }} style="background: #fff; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 22px; text-decoration: none; color: #1d1c1c; min-height: 44px;">
            <span style="display: flex; flex-direction: column; gap: 2px;"><span style="font-weight: 600; font-size: 16px;">{{ block.settings.title }}</span><span style="font-size: 13px; color: #6b655e;">{{ meta }}</span></span>
            <svg aria-hidden="true" fill="none" height="20" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" width="20"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>
          </a>
        {%- endfor -%}
      </div>
      {%- if section.settings.trade_title != blank -%}
        <div style="background: #161616; color: #fff; padding: 28px; display: flex; flex-direction: column; gap: 14px;">
          <div style="font-size: 20px; font-weight: 600;">{{ section.settings.trade_title }}</div>
          <div style="font-size: 15px; line-height: 1.55; color: #c9c4bd;">{{ section.settings.trade_text }}</div>
          <a href="{{ section.settings.trade_link }}" style="align-self: flex-start; color: #fff; font-weight: 600; font-size: 15px; border-bottom: 1px solid #b6855f; padding-bottom: 3px; text-decoration: none;">{{ section.settings.trade_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Vertex specifications",
  "settings": [
    { "type": "text", "id": "specs_title", "label": "Specifications heading", "default": "Specifications" },
    { "type": "text", "id": "downloads_title", "label": "Downloads heading", "default": "Downloads" },
    { "type": "text", "id": "trade_title", "label": "Trade box heading", "default": "Buying for a trade project?" },
    { "type": "text", "id": "trade_text", "label": "Trade box text", "default": "Open a trade account for [TRADE TERMS TO CONFIRM]." },
    { "type": "text", "id": "trade_label", "label": "Trade link label", "default": "Apply for a trade account" },
    { "type": "url", "id": "trade_link", "label": "Trade link" }
  ],
  "blocks": [
    { "type": "download", "name": "Download", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "select", "id": "source", "label": "File", "options": [
        { "value": "data_sheet", "label": "Product data sheet (metafield)" },
        { "value": "safety_data_sheet", "label": "Product safety data sheet (metafield)" },
        { "value": "page", "label": "Link to a page" }
      ], "default": "data_sheet" },
      { "type": "url", "id": "link", "label": "Link (for pages)" }
    ]}
  ],
  "presets": [{ "name": "Vertex specifications" }]
}
{% endschema %}
